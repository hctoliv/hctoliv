# --- Claude (obrigatório) ---
ANTHROPIC_API_KEY=
# Modelo e esforço de raciocínio. "low" deixa as respostas rápidas e baratas para chat.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Atendimento ---
BOT_NAME=Lia
# WhatsApp do(s) vendedor(es) que recebem o aviso do lead. Só números, com DDI+DDD.
# Vários vendedores: separe por vírgula (o bot faz rodízio entre eles).
VENDEDORES_WHATSAPP=5511999999999
# Permite que a IA consulte o site inovelabor.com.br para achar produtos (true/false).
PERMITIR_BUSCA_NO_SITE=true
# Se alguém da equipe responder manualmente pelo número do bot, a IA fica pausada
# naquela conversa por este número de horas.
PAUSA_APOS_HUMANO_HORAS=12

# --- RD Station Marketing (opcional) ---
# Chave pública da API (RD Station > Perfil > Integrações > Chave de API pública).
RD_STATION_API_KEY=
RD_CONVERSION_IDENTIFIER=lead-whatsapp-ia

# --- Técnico ---
# Pasta onde ficam a sessão do WhatsApp e o histórico das conversas.
DATA_DIR=./data
LOG_LEVEL=info
