# --- Claude (obrigatório) ---
ANTHROPIC_API_KEY=
# Modelo e esforço de raciocínio. "low" deixa as respostas rápidas e baratas para chat.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# --- Atendimento ---
BOT_NAME=Lia
# O bot roda no WhatsApp (11) 2791-2239. Os vendedores precisam ser OUTROS números
# (o bot não consegue mandar mensagem para ele mesmo).
# WhatsApp do(s) vendedor(es) que recebem o aviso do lead. Só números, com DDI+DDD.
# Vários vendedores: separe por vírgula (o bot faz rodízio entre eles).
VENDEDORES_WHATSAPP=5511987685469,5511926594857
# MODO TESTE: enquanto tiver números aqui, o bot SÓ responde esses números
# (os outros clientes continuam sendo atendidos pela equipe, normalmente).
# Para liberar para todos: deixe vazio (NUMEROS_TESTE=) e reinicie o bot.
NUMEROS_TESTE=5511987685469,5511926594857
# Permite que a IA consulte o site inovelabor.com.br para achar produtos (true/false).
PERMITIR_BUSCA_NO_SITE=true
# Se alguém da equipe responder manualmente pelo número do bot, a IA fica pausada
# naquela conversa por este número de horas.
PAUSA_APOS_HUMANO_HORAS=12

# --- Painel web (QR Code + monitor das conversas) ---
# Abre em http://localhost:3000 (no servidor: http://IP-DO-SERVIDOR:3000).
PAINEL_PORTA=3000
# Senha do painel (OBRIGATÓRIA na AWS). Usuário: qualquer.
PAINEL_SENHA=

# --- RD Station Marketing (opcional) ---
# Chave pública da API (RD Station > Perfil > Integrações > Chave de API pública).
RD_STATION_API_KEY=
RD_CONVERSION_IDENTIFIER=lead-whatsapp-ia

# --- Técnico ---
# Pasta onde ficam a sessão do WhatsApp e o histórico das conversas.
DATA_DIR=./data
LOG_LEVEL=info
